---
/**
 * BlogCta — the block that closes every blog surface.
 *
 * It replaced "Follow along", which offered RSS, the social accounts, an email
 * link and a signup form. Every one of those now sits in the footer, on every
 * page rather than on the blog alone, so the block was repeating what a reader
 * already had a screen further down.
 *
 * What the end of a post can do that a footer cannot is ask for something. The
 * wording and the single-button shape are the about page's, so this reads as
 * the same invitation wherever someone meets it; the copy is `blog.cta` in the
 * locale files, which makes changing it a content change.
 *
 * One band at every width. It used to be a pair — a flat CTA on a phone and
 * the LetterGlitch band from `glitch` up — because the canvas cannot run below
 * that breakpoint. A gradient has no such limit, so the duplicate is gone and
 * every screen gets the same block.
 */
import CtaBand from '@/components/patterns/CtaBand.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import siteConfig from '@/config/site.config';
import { t } from '@/i18n';

interface Props {
  locale: string;
  /** Classes for the section wrapping the band — background, spacing. */
  sectionClass?: string;
  /** Inner width of the band. Matches CtaBand's own prop. */
  maxWidth?: '6xl' | '7xl';
  /**
   * Swap the gradient band for the LetterGlitch canvas on desktop.
   *
   * Off everywhere but the post that documents the effect, which is the one
   * page where a reader is there for it. Below `glitch` — 1024px and a fine
   * pointer — the canvas cannot run, so those screens keep the gradient band
   * and the page still closes on something.
   */
  glitch?: boolean;
}

const { locale, sectionClass, maxWidth = '6xl', glitch = false } = Astro.props;

/**
 * The repo, taken from the site's own links so a fork points at its own rather
 * than at this one. Falls back to the theme's repository.
 */
const repoUrl =
  siteConfig.socialLinks.find((url) => url.includes('github.com')) ??
  'https://github.com/hansmartensdev/astro-rocket';
---

<section class={sectionClass}>
  <CtaBand maxWidth={maxWidth} class={glitch ? 'glitch:hidden' : undefined}>
    <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
      {t('blog.cta.heading', locale)}
    </h2>
    <p class="text-lg text-foreground-muted mb-8 text-balance">
      {t('blog.cta.description', locale)}
    </p>

    <div class="flex justify-center">
      <Button
        size="lg"
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="gap-2"
      >
        <Icon name="github" size="sm" />
        {t('blog.cta.button', locale)}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </CtaBand>

  {glitch && (
    <LetterGlitchBand maxWidth={maxWidth}>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {t('blog.cta.heading', locale)}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {t('blog.cta.description', locale)}
      </p>

      <div class="flex justify-center">
        <Button
          size="lg"
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="gap-2 hero-btn-brand"
        >
          <Icon name="github" size="sm" />
          {t('blog.cta.button', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </LetterGlitchBand>
  )}
</section>
