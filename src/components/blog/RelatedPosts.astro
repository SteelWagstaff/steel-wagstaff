---
import BlogCard from './BlogCard.astro';
import { getBlogReadingTime, getMergedBlogEntries } from '@/lib/load-blog-content';

interface Props {
  currentSlug: string;
  tags: string[];
  locale?: string;
  maxPosts?: number;
}

const { currentSlug, tags, maxPosts = 3 } = Astro.props;

// Get all published posts in the same locale
const allPosts = await getMergedBlogEntries();

// Filter to find posts with matching tags
const relatedPosts = allPosts
  .filter((post) => {
    // Exclude current post
    if (post.slug === currentSlug) return false;

    // Must have at least one matching tag
    if (!tags.length) return false;
    return post.tags.some((tag) => tags.includes(tag));
  })
  // Sort by number of matching tags, then by date
  .sort((a, b) => {
    const aMatches = a.tags.filter((tag) => tags.includes(tag)).length;
    const bMatches = b.tags.filter((tag) => tags.includes(tag)).length;

    if (bMatches !== aMatches) return bMatches - aMatches;
    return b.publishedAt.valueOf() - a.publishedAt.valueOf();
  })
  .slice(0, maxPosts);

// Generate URLs for each post (remove locale prefix from id)
const getPostUrl = (slug: string) => `/blog/${slug}`;
---

{relatedPosts.length > 0 && (
  <section class="border-t border-border py-[var(--space-section-sm)]">
    <h2 class="font-display text-2xl font-bold text-foreground mb-[var(--space-stack-lg)]">
      Related Posts
    </h2>

    <div class="grid gap-[var(--space-stack-lg)] md:grid-cols-2 lg:grid-cols-3">
      {relatedPosts.map((post) => (
        <BlogCard
          title={post.title}
          description={post.description}
          readingTime={getBlogReadingTime(post)}
          href={getPostUrl(post.slug)}
          publishedAt={post.publishedAt}
          tags={post.tags}
          author={post.author}
          image={post.image}
          svgSlug={post.svgSlug}
        />
      ))}
    </div>
  </section>
)}
