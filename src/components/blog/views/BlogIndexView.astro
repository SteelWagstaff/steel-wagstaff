---
/**
 * BlogIndexView — the blog landing page (page 1).
 *
 * Shared body for the default-locale route (`/blog`) and the locale-prefixed
 * route (`/<locale>/blog`). All post/pagination/tag URLs are built locale-aware
 * via the helpers in `lib/blog`, so rendering with the default locale produces
 * exactly the same markup the route did before this was extracted.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import TagList from '@/components/blog/TagList.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { Hero } from '@/components/hero';
import { t, defaultLocale } from '@/i18n';
import BlogCta from '@/components/blog/BlogCta.astro';
import {
  BLOG_POSTS_PER_PAGE,
  BLOG_TAG_CLOUD_LIMIT,
  collectTopTags,
  getBlogPageUrl,
  getPostUrl,
  getPublishedPosts,
} from '@/lib/blog';

interface Props {
  /** Locale whose posts this index renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;


// Newsletter signup — opt-in, since the endpoint needs Resend keys to work.

const posts = await getPublishedPosts(locale);

// Featured posts always appear on page 1; the "All posts" grid paginates
// the non-featured set so the first impression stays curated.
const featuredPosts = posts.filter((post) => post.data.featured);
const nonFeaturedPosts = posts.filter((post) => !post.data.featured);
// If everything is featured, mirror it into the main grid so the page isn't empty.
const regularPostsAll = nonFeaturedPosts.length > 0 ? nonFeaturedPosts : posts;

const totalPages = Math.max(1, Math.ceil(regularPostsAll.length / BLOG_POSTS_PER_PAGE));
const regularPosts = regularPostsAll.slice(0, BLOG_POSTS_PER_PAGE);

const topTags = collectTopTags(posts, BLOG_TAG_CLOUD_LIMIT);
---

<PageLayout title={t('blog.metaTitle', locale)} description={t('blog.metaDescription', locale)} showScrollProgress eagerReveal footerBackground={featuredPosts.length > 0 ? 'default' : 'secondary'}>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="book" size="sm" />
      {t('blog.heroBadge', locale)}
    </Badge>

    <h1 slot="title">{t('blog.title', locale)}</h1>

    <p slot="description" class="!text-balance">{t('blog.heroDescription', locale)}</p>
  </Hero>

  <!-- Featured Posts Section -->
  {
    featuredPosts.length > 0 && (
      <section id="featured-section" class="bg-background-secondary py-[var(--space-section-md)] border-t border-border">
        <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
          <h2 class="font-display text-foreground text-3xl md:text-4xl font-bold text-center" data-reveal>
            {t('blog.featured', locale)}
          </h2>

          <div class="grid gap-6 sm:grid-cols-2">
            {featuredPosts.map((post, index) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={getPostUrl(post.id, locale)}
                publishedAt={post.data.publishedAt}
                tags={post.data.tags}
                author={post.data.author}
                image={post.data.image}
                svgSlug={post.data.svgSlug}
                body={post.body}
                revealDelay={index % 2}
                eager={index === 0}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- All Posts Section -->
  <section class:list={[featuredPosts.length > 0 ? 'bg-background' : 'bg-background-secondary', 'py-[var(--space-section-md)] border-t border-border']}>
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4" data-reveal>
        {
          featuredPosts.length > 0 && nonFeaturedPosts.length > 0 && (
            <h2 class="font-display text-foreground text-3xl md:text-4xl font-bold text-center">{t('blog.allPosts', locale)}</h2>
          )
        }

        {topTags.length > 0 && (
          <TagList tags={topTags} locale={locale} class="justify-center" />
        )}
      </div>

      {
        regularPosts.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {regularPosts.map((post, index) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={getPostUrl(post.id, locale)}
                publishedAt={post.data.publishedAt}
                tags={post.data.tags}
                author={post.data.author}
                image={post.data.image}
                svgSlug={post.data.svgSlug}
                body={post.body}
                revealDelay={index % 3}
                eager={featuredPosts.length === 0 && index === 0}
              />
            ))}
          </div>
        ) : (
          <div class="py-16 text-center">
            <div class="bg-background mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full">
              <Icon name="file-text" size="lg" class="text-foreground-muted" />
            </div>
            <p class="text-foreground-muted text-lg">{t('blog.noPosts', locale)}</p>
          </div>
        )
      }

      <Pagination
        currentPage={1}
        totalPages={totalPages}
        href={(page) => getBlogPageUrl(page, locale)}
      />
    </div>
  </section>

  <!-- Closing CTA -->
  <BlogCta
    locale={locale}
    sectionClass={`relative z-10 py-[var(--space-section-md)] ${featuredPosts.length > 0 ? 'bg-background-secondary' : 'bg-background'}`}
  />
</PageLayout>
