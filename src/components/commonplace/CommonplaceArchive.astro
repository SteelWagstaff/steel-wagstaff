---
import type { CommonplaceCounts, CommonplaceType } from '@/lib/commonplace';
import type { NormalizedCommonplaceEntry } from '@/sanity/lib/types';
import OptimizedImage from '@/components/ui/content/OptimizedImage.astro';
import PortableText from '@/components/sanity/PortableText.astro';
import { urlForImage } from '@/sanity/lib/url-for-image';
import type { SanityImage } from '@/sanity/lib/types';

interface Props {
  items: NormalizedCommonplaceEntry[];
  totalItems: number;
  currentPage: number;
  totalPages: number;
  counts: CommonplaceCounts;
  typeFilter?: CommonplaceType;
}

const { items, totalItems, currentPage, totalPages, counts, typeFilter } = Astro.props;

const getPreviewText = (item: NormalizedCommonplaceEntry) => {
  const legacyBody = item.localEntry && typeof item.localEntry === 'object' && 'body' in item.localEntry
    && typeof item.localEntry.body === 'string'
    ? item.localEntry.body
    : '';
  const source = typeof item.content === 'string' ? item.content : legacyBody;
  return source
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/(p|div|blockquote|li|h[1-6])\s*>/gi, '\n')
    .replace(/<[^>]*>/g, '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/[#*_>`]/g, '')
    .replace(/[ \t]+/g, ' ')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
};

const getTypeLabel = (type: string) => type === 'photo' ? 'Image' : type.charAt(0).toUpperCase() + type.slice(1);
const getMediaUrl = (url: string) => /^https?:\/\//i.test(url) ? url : `/${url}`.replace(/^\/+/, '/');
const pageUrl = (page: number) => typeFilter
  ? `/commonplace/type/${typeFilter}/${page}`
  : page === 1 ? '/commonplace' : `/commonplace/page/${page}`;
const typeUrl = (type: CommonplaceType) => typeFilter === type
  ? '/commonplace'
  : `/commonplace/type/${type}/1`;

const typeStats = ([
  { type: 'text', label: 'Text', count: counts.text, color: 'text-brand-500' },
  { type: 'photo', label: 'Images', count: counts.photo, color: 'text-brand-500' },
  { type: 'video', label: 'Videos', count: counts.video, color: 'text-brand-500' },
  { type: 'audio', label: 'Audio', count: counts.audio, color: 'text-brand-500' },
] satisfies Array<{ type: CommonplaceType; label: string; count: number; color: string }>).sort(
  (a, b) => b.count - a.count
);
---

<div class="mx-auto max-w-6xl space-y-10 px-6 py-12">
  <header class="max-w-3xl">
    <h1 class="mb-4 text-4xl font-bold text-foreground">The Commonplace</h1>
    <p class="mb-4 text-lg leading-relaxed text-foreground-muted">
      Text, images, songs, and videos migrated from <a href="https://steelwagstaff.tumblr.com/" class="text-brand-500 hover:underline">Tumblr</a>. Still a work in progress.
    </p>
  </header>

  <div class="grid grid-cols-2 gap-4 mb-4 md:grid-cols-4">
    {typeStats.map((stat) => (
      <a
        href={typeUrl(stat.type)}
        class:list={[
          'rounded-lg border border-border bg-background-secondary p-4 transition-colors hover:border-brand-500',
          typeFilter === stat.type && 'border-brand-700 bg-brand-700 text-white hover:border-brand-800 hover:bg-brand-800',
        ]}
      >
        <p class:list={['text-2xl font-bold', typeFilter === stat.type ? 'text-white' : stat.color]}>{stat.count}</p>
        <p class:list={['text-md', typeFilter === stat.type ? 'text-white' : 'text-foreground-muted']}>{stat.label}</p>
      </a>
    ))}
  </div>

  <section class="space-y-6">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold text-foreground">All Posts</h2>
      <p class="text-sm text-foreground-muted">
        {totalItems} entries / Page {currentPage} of {totalPages} 
      </p>
    </div>
    <nav class="flex items-center justify-between" aria-label="Commonplace pagination">
      {currentPage > 1 ? (
        <a href={pageUrl(currentPage - 1)} class="text-sm font-medium text-brand-500 hover:underline">← Newer posts</a>
      ) : <span />}
      {currentPage < totalPages ? (
        <a href={pageUrl(currentPage + 1)} class="text-sm font-medium text-brand-500 hover:underline">Older posts →</a>
      ) : <span />}
    </nav>

    <div class="columns-1 gap-6 md:columns-2">
      {items.map((item) => {
        const previewText = getPreviewText(item);
        return (
          <article class="group mb-6 break-inside-avoid overflow-hidden rounded-lg border border-border bg-background transition-colors hover:border-brand-500">
            <div class="flex flex-col gap-4 p-5">
              {item.type === 'photo' && item.image && (
                <div class="w-full overflow-hidden rounded-md bg-background-secondary">
                  <OptimizedImage
                    src={typeof item.image === 'string'
                      ? `/${item.image}`.replace(/^\/+/, '/')
                      : urlForImage(item.image as SanityImage).width(1600).format('webp').url()}
                    alt={item.imageAlt || item.title || 'Commonplace image'}
                    class="block h-auto w-full"
                    sizes="(max-width: 768px) 100vw, 50vw"
                    loading="lazy"
                  />
                </div>
              )}

              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-start gap-2">
                  {item.title && <h3 class="line-clamp-3 text-lg font-semibold text-foreground">{item.title}</h3>}
                </div>

                {item.type === 'video' && item.videoUrl && (
                  <div class="mb-4 aspect-video overflow-hidden rounded-md bg-background-secondary">
                    <iframe
                      src={item.videoUrl}
                      title={item.title || 'Commonplace video'}
                      class="h-full w-full"
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    ></iframe>
                  </div>
                )}

                {Array.isArray(item.content) && item.content.length > 0 ? (
                  <PortableText value={item.content} />
                ) : previewText && (
                  <p class="whitespace-pre-line text-md leading-relaxed text-foreground-muted">
                    {previewText}
                  </p>
                )}

                {item.type === 'audio' && item.audioUrl && (
                  <audio controls preload="none" class="mt-3 w-full" src={getMediaUrl(item.audioUrl)} />
                )}

                <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-foreground-subtle">
                  <span class="rounded-full bg-background-secondary px-2.5 py-1 font-medium">
                    {getTypeLabel(item.type)}
                  </span>
                  <time datetime={item.publishedAt.toISOString()}>
                    {item.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  {item.sourceUrl && <span>via {item.sourceUrl}</span>}
                </div>

                {item.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {item.tags.slice(0, 4).map((tag) => (
                      <span class="text-xs text-foreground-subtle">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <nav class="flex items-center justify-between border-t border-border pt-6" aria-label="Commonplace pagination">
      {currentPage > 1 ? (
        <a href={pageUrl(currentPage - 1)} class="text-sm font-medium text-brand-500 hover:underline">← Newer posts</a>
      ) : <span />}
      {currentPage < totalPages ? (
        <a href={pageUrl(currentPage + 1)} class="text-sm font-medium text-brand-500 hover:underline">Older posts →</a>
      ) : <span />}
    </nav>
  </section>
</div>
