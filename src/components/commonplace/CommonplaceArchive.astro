---
import type { CollectionEntry } from 'astro:content';
import type { CommonplaceCounts, CommonplaceType } from '@/lib/commonplace';
import OptimizedImage from '@/components/ui/content/OptimizedImage.astro';

interface Props {
  items: CollectionEntry<'commonplace'>[];
  totalItems: number;
  currentPage: number;
  totalPages: number;
  counts: CommonplaceCounts;
  typeFilter?: CommonplaceType;
}

const { items, totalItems, currentPage, totalPages, counts, typeFilter } = Astro.props;

const getPreviewText = (item: CollectionEntry<'commonplace'>) => {
  const source = item.data.content || item.body || '';
  return source
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/(p|div|blockquote|li|h[1-6])\s*>/gi, '\n')
    .replace(/<[^>]*>/g, '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/[#*_>`]/g, '')
    .replace(/[ \t]+/g, ' ')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
};

const getTypeLabel = (type: string) => type === 'photo' ? 'Image' : type.charAt(0).toUpperCase() + type.slice(1);
const getMediaUrl = (url: string) => /^https?:\/\//i.test(url) ? url : `/${url}`.replace(/^\/+/, '/');
const pageUrl = (page: number) => typeFilter
  ? `/commonplace/type/${typeFilter}/${page}`
  : page === 1 ? '/commonplace' : `/commonplace/page/${page}`;
const typeUrl = (type: CommonplaceType) => `/commonplace/type/${type}/1`;

const typeIconColors = {
  photo: 'text-blue-400',
  audio: 'text-orange-400',
  video: 'text-violet-400',
  text: 'text-teal-400',
} as const;

const typeStats = ([
  { type: 'text', label: 'Text', count: counts.text, color: 'text-teal-400' },
  { type: 'photo', label: 'Images', count: counts.photo, color: 'text-blue-400' },
  { type: 'video', label: 'Videos', count: counts.video, color: 'text-violet-400' },
  { type: 'audio', label: 'Audio', count: counts.audio, color: 'text-orange-400' },
] satisfies Array<{ type: CommonplaceType; label: string; count: number; color: string }>).sort(
  (a, b) => b.count - a.count
);
---

<div class="mx-auto max-w-6xl space-y-10 px-6 py-12">
  <header class="max-w-3xl">
    <h1 class="mb-4 text-4xl font-bold text-foreground">The Commonplace</h1>
    <p class="mb-4 text-lg leading-relaxed text-foreground-muted">
      Images, text, songs, and videos migrated from <a href="https://steelwagstaff.tumblr.com/" class="text-brand-500 hover:underline">Tumblr</a>. Still a work in progress.
    </p>
  </header>

  <div class="grid grid-cols-2 gap-4 mb-4 md:grid-cols-4">
    {typeStats.map((stat) => (
      <a href={typeUrl(stat.type)} class:list={['rounded-lg border border-border bg-background-secondary p-4 transition-colors hover:border-brand-500', typeFilter === stat.type && 'border-brand-500']}>
        <p class:list={['text-2xl font-bold', stat.color]}>{stat.count}</p>
        <p class="text-md text-foreground-muted">{stat.label}</p>
      </a>
    ))}
  </div>

  <section class="space-y-6">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold text-foreground">All Posts</h2>
      <p class="text-sm text-foreground-muted">
        {totalItems} entries / Page {currentPage} of {totalPages} 
      </p>
    </div>
    <nav class="flex items-center justify-between" aria-label="Commonplace pagination">
      {currentPage > 1 ? (
        <a href={pageUrl(currentPage - 1)} class="text-sm font-medium text-brand-500 hover:underline">← Newer posts</a>
      ) : <span />}
      {currentPage < totalPages ? (
        <a href={pageUrl(currentPage + 1)} class="text-sm font-medium text-brand-500 hover:underline">Older posts →</a>
      ) : <span />}
    </nav>

    <div class="columns-1 gap-6 md:columns-2">
      {items.map((item) => {
        const previewText = getPreviewText(item);
        return (
          <article class="group mb-6 break-inside-avoid overflow-hidden rounded-lg border border-border bg-background transition-colors hover:border-brand-500">
            <div class="flex flex-col gap-4 p-5">
              {item.data.type === 'photo' && item.data.image && (
                <div class="w-full overflow-hidden rounded-md bg-background-secondary">
                  <OptimizedImage
                    src={`/${item.data.image}`.replace(/^\/+/, '/')}
                    alt={item.data.imageAlt || item.data.title || 'Commonplace image'}
                    class="block h-auto w-full"
                    sizes="(max-width: 768px) 100vw, 50vw"
                    loading="lazy"
                  />
                </div>
              )}

              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-start gap-2">
                  {item.data.title && <h3 class="line-clamp-3 text-lg font-semibold text-foreground">{item.data.title}</h3>}
                </div>

                {item.data.type === 'video' && item.data.videoUrl && (
                  <div class="mb-4 aspect-video overflow-hidden rounded-md bg-background-secondary">
                    <iframe
                      src={item.data.videoUrl}
                      title={item.data.title || 'Commonplace video'}
                      class="h-full w-full"
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    ></iframe>
                  </div>
                )}

                {previewText && (
                  <p class="whitespace-pre-line text-md leading-relaxed text-foreground-muted">
                    {previewText}
                  </p>
                )}

                {item.data.type === 'audio' && item.data.audioUrl && (
                  <audio controls preload="none" class="mt-3 w-full" src={getMediaUrl(item.data.audioUrl)} />
                )}

                <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-foreground-subtle">
                  <span class="rounded-full bg-background-secondary px-2.5 py-1 font-medium">
                    {getTypeLabel(item.data.type)}
                  </span>
                  <time datetime={item.data.publishedAt.toISOString()}>
                    {item.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  {item.data.source && <span>via {item.data.source}</span>}
                </div>

                {item.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {item.data.tags.slice(0, 4).map((tag) => (
                      <span class="text-xs text-foreground-subtle">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <nav class="flex items-center justify-between border-t border-border pt-6" aria-label="Commonplace pagination">
      {currentPage > 1 ? (
        <a href={pageUrl(currentPage - 1)} class="text-sm font-medium text-brand-500 hover:underline">← Newer posts</a>
      ) : <span />}
      {currentPage < totalPages ? (
        <a href={pageUrl(currentPage + 1)} class="text-sm font-medium text-brand-500 hover:underline">Older posts →</a>
      ) : <span />}
    </nav>
  </section>
</div>
