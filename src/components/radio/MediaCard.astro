---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DateMeta from '@/components/ui/data-display/DateMeta.astro';
import { resolveMusicImage } from '@/lib/music-image-resolver';
import { slugifyTaxonomyLabel } from '@/lib/taxonomy';

interface Props {
  title: string;
  href: string;
  publishedAt: Date;
  description?: string;
  image?: string;
  imageAlt?: string;
  tags?: string[];
  groupLabel?: string;
  groupSlug?: string;
  episode?: number;
}

const {
  title,
  href,
  publishedAt,
  description,
  image,
  imageAlt,
  tags = [],
  groupLabel,
  groupSlug,
  episode,
} = Astro.props;

const resolvedImage = resolveMusicImage(image);
---

<article class="group block overflow-hidden rounded-lg border border-border hover:border-primary hover:shadow-lg transition-all">
  <a href={href} class="block">
    {resolvedImage && (
      <div class="aspect-[3/2] overflow-hidden bg-muted">
        {typeof resolvedImage === 'string' ? (
          <img
            src={resolvedImage}
            alt={imageAlt || title}
            class="h-full w-full object-cover transition-transform group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <Image
            src={resolvedImage as ImageMetadata}
            alt={imageAlt || title}
            class="h-full w-full object-cover transition-transform group-hover:scale-105"
          />
        )}
      </div>
    )}
    <div class="p-4">
      <h3 class="line-clamp-2 font-semibold transition-colors group-hover:text-primary">
        {title}
      </h3>
      {description && <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{description}</p>}
    </div>
  </a>

  <div class="px-4 pb-4">
    <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
      {episode && <span>Episode {episode} •</span>}
      <DateMeta date={publishedAt} />
    </div>

    {groupLabel && groupSlug && (
      <a href={`/radio-podcasts/topics/${groupSlug}`} class="mt-3 inline-block text-xs font-medium text-primary hover:underline">
        {groupLabel}
      </a>
    )}

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1">
        {tags.map((tag) => (
          <a
            href={`/radio-podcasts/topics/${slugifyTaxonomyLabel(tag)}`}
            class="rounded bg-primary/10 px-2 py-1 text-xs text-primary hover:bg-primary/20"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
