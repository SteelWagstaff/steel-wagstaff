---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import MediaCard from '@/components/radio/MediaCard.astro';
import { getRadioTaxonomies, matchesRadioTaxonomy } from '@/lib/taxonomy';

export async function getStaticPaths() {
  const music = await getCollection('music', ({ data }) => data.locale === 'en' && data.draft !== true);
  const podcasts = await getCollection('podcasts', ({ data }) => data.locale === 'en' && data.draft !== true);
  const taxonomies = getRadioTaxonomies(music, podcasts);
  const entries = [
    ...music.map((entry) => ({ entry, source: 'music' as const })),
    ...podcasts.map((entry) => ({ entry, source: 'podcasts' as const })),
  ];

  return taxonomies.map((taxonomy) => ({
    params: { slug: taxonomy.slug },
    props: {
      taxonomy,
      entries: entries
        .filter(({ entry }) => matchesRadioTaxonomy(entry, taxonomy))
        .sort((a, b) => b.entry.data.publishedAt.valueOf() - a.entry.data.publishedAt.valueOf()),
    },
  }));
}

const { taxonomy, entries } = Astro.props;
const getSlug = (id: string) => id.replace('en/', '');

const getGrouping = (entry: typeof entries[number]) => {
  if (entry.source === 'podcasts') {
    return { label: entry.entry.data.podcast, slug: entry.entry.data.podcast ? entry.entry.data.podcast.toLowerCase().replace(/\s+/g, '-') : undefined };
  }
  if (entry.entry.id.includes('show-')) return { label: "Steel's Magnolias", slug: 'steels-magnolias' };
  if (entry.entry.data.tags.includes('mixtape')) return { label: 'Mixtapes', slug: 'mixtapes' };
  return { label: 'Playlists', slug: 'playlists' };
};
---

<PageLayout title={`${taxonomy.label} | Radio + Podcasts`} description={taxonomy.description}>
  <div class="mx-auto max-w-6xl px-6 py-12">
    <header class="mb-10">
      <a href="/radio-podcasts" class="text-sm text-foreground-muted hover:text-foreground transition-colors">← Back to Radio + Podcasts</a>
      <h1 class="mt-4 text-4xl font-bold">{taxonomy.label}</h1>
      <p class="mt-3 text-lg text-muted-foreground">{taxonomy.description}</p>
    </header>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {entries.map(({ entry, source }) => {
        const grouping = getGrouping({ entry, source });
        return (
          <MediaCard
            title={entry.data.title}
            href={`/${source}/${getSlug(entry.id)}`}
            publishedAt={entry.data.publishedAt}
            description={entry.data.description}
            image={entry.data.image}
            imageAlt={entry.data.imageAlt}
            tags={entry.data.tags}
            groupLabel={grouping.label}
            groupSlug={grouping.slug}
            episode={source === 'podcasts' ? entry.data.episode : undefined}
          />
        );
      })}
    </div>
  </div>
</PageLayout>
