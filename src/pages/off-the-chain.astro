---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { getCollection } from 'astro:content';
import { resolveMusicImage } from '@/lib/music-image-resolver';

// Get all published podcast episodes for Off the Chain
const allEpisodes = await getCollection('podcasts', ({ data }) => {
  return data.draft !== true;
});

// Filter to only Off the Chain episodes
const episodes = allEpisodes
  .filter((e) => e.data.locale === 'en' && e.data.podcast === 'Off the Chain')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const getEpisodeUrl = (id: string) => {
  const slug = id.replace('en/', '');
  return `/podcasts/${slug}`;
};
---

<PageLayout title="Off the Chain Podcast — Steel Wagstaff" description="Episodes from Off the Chain, a DIY podcast with Dave Jenson." showScrollProgress eagerReveal>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="podcast" size="sm" />
      Podcast
    </Badge>

    <h1 slot="title">Off the Chain</h1>

    <p slot="description">A DIY podcast with Dave Jenson exploring culture, action movies, terrible haircuts, and more.</p>
  </Hero>

  <!-- Podcast Info Section -->
  <section class="bg-background py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-3xl px-6">
      <div class="space-y-6 text-foreground-muted">
        <p>In January 2015 I started making Off the Chain with my old college roommate <a href="https://asknursedave.blogspot.com/" class="text-brand hover:underline">Dave Jenson</a>. We ran it as a ramshackle variety show, with regular segments dedicated to things Dave loves (action movies, incredible feats of human endurance, children's books), things I love (terrible haircuts, unusual names, documentary films) and things we both love (sports, music, & literature).</p>
        <p>We released 70+ episodes over the course of about two years before retiring the show to start <a href="/theme-songs" class="text-brand hover:underline">Theme Songs</a>.</p>
      </div>
    </div>
  </section>

  <!-- Episodes List -->
  <section class="bg-background py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {episodes.map((episode, idx) => (
          <div
            data-reveal
            data-reveal-delay={idx % 3}
            class="h-full"
          >
            <a href={getEpisodeUrl(episode.id)} class="block group">
              <Card class="h-full hover:border-brand hover:shadow-lg transition-all duration-300 overflow-hidden">
                {episode.data.image && (
                  <div class="aspect-video bg-muted overflow-hidden mb-3">
                    {(() => {
                      const resolvedImg = resolveMusicImage(episode.data.image);
                      return typeof resolvedImg === 'object' && resolvedImg ? (
                        <Image 
                          src={resolvedImg}
                          alt={episode.data.imageAlt || episode.data.title}
                          widths={[320, 640, 960]}
                          sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 400px"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                        />
                      ) : null;
                    })()}
                  </div>
                )}
                <div class="flex flex-col gap-3 px-4 pb-4 h-full">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                      {episode.data.episode && (
                        <div class="text-xs text-foreground-muted mb-2">
                          Episode {episode.data.episode}
                        </div>
                      )}
                      <h3 class="font-display text-lg font-bold text-foreground group-hover:text-brand transition-colors line-clamp-2">
                        {episode.data.title}
                      </h3>
                    </div>
                    <Icon name="play-circle" size="lg" class="text-foreground-muted group-hover:text-brand flex-shrink-0" />
                  </div>

                  {episode.data.description && (
                    <p class="text-sm text-foreground-muted line-clamp-2 flex-grow">
                      {episode.data.description}
                    </p>
                  )}

                  <div class="flex items-center justify-between pt-2 border-t border-border mt-auto">
                    <time class="text-xs text-foreground-muted">
                      {new Intl.DateTimeFormat('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      }).format(episode.data.publishedAt)}
                    </time>
                  </div>
                </div>
              </Card>
            </a>
          </div>
        ))}
      </div>

      {episodes.length === 0 && (
        <div class="text-center py-12">
          <p class="text-foreground-muted">No episodes found.</p>
        </div>
      )}
    </div>
  </section>
</PageLayout>
