---
import PageLayout from '@/layouts/PageLayout.astro';
import CommonplaceArchive from '@/components/commonplace/CommonplaceArchive.astro';
import { getMergedCommonplaceEntries } from '@/lib/commonplace-content';
import {
  getCommonplacePageCount,
  getCommonplacePageEntries,
  getCommonplaceCounts,
} from '@/lib/commonplace';

const allItems = await getMergedCommonplaceEntries();
const totalPages = getCommonplacePageCount(allItems.length);
---

<PageLayout title="The Commonplace" description="Words, images, songs worth remembering.">
  <CommonplaceArchive
    items={getCommonplacePageEntries(allItems, 1)}
    totalItems={allItems.length}
    currentPage={1}
    totalPages={totalPages}
    counts={getCommonplaceCounts(allItems)}
  />
</PageLayout>
