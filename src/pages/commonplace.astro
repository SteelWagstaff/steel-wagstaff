---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';

const allCommonplaceItems = (await getCollection('commonplace')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const totalItems = allCommonplaceItems.length;
const photoPosts = allCommonplaceItems.filter(item => item.data.type === 'photo');
const audioPosts = allCommonplaceItems.filter(item => item.data.type === 'audio');
const videoPosts = allCommonplaceItems.filter(item => item.data.type === 'video');
const quotePosts = allCommonplaceItems.filter(item => item.data.type === 'quote');

// Load first 100 items
const commonplaceItems = allCommonplaceItems.slice(0, 100);
const hasMore = totalItems > 100;
---

<PageLayout title="Commonplace" description="Archive of tumblr posts">
  <div class="max-w-4xl mx-auto space-y-8 px-4">
    <div>
      <h1 class="text-4xl font-bold mb-4">Commonplace</h1>
      <p class="text-lg text-gray-300">
        Archive of {totalItems} posts migrated from tumblr
      </p>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-slate-900 p-4 rounded-lg border border-slate-700">
        <p class="text-2xl font-bold text-blue-400">{photoPosts.length}</p>
        <p class="text-sm text-gray-400">Photos</p>
      </div>
      <div class="bg-slate-900 p-4 rounded-lg border border-slate-700">
        <p class="text-2xl font-bold text-emerald-400">{quotePosts.length}</p>
        <p class="text-sm text-gray-400">Quotes</p>
      </div>
      <div class="bg-slate-900 p-4 rounded-lg border border-slate-700">
        <p class="text-2xl font-bold text-violet-400">{videoPosts.length}</p>
        <p class="text-sm text-gray-400">Videos</p>
      </div>
      <div class="bg-slate-900 p-4 rounded-lg border border-slate-700">
        <p class="text-2xl font-bold text-orange-400">{audioPosts.length}</p>
        <p class="text-sm text-gray-400">Audio</p>
      </div>
    </div>

    <!-- All Items Grid -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold">All Posts</h2>
      <div class="grid gap-6" id="posts-container">
        {commonplaceItems.map((item) => (
          <div class="bg-slate-900 border border-slate-700 rounded-lg overflow-hidden hover:border-slate-600 transition-colors">
            <div class="p-4 md:p-6 flex flex-col md:flex-row gap-4">
              {/* Media Preview */}
              <div class="flex-shrink-0 w-full md:w-32 h-32">
                {item.data.type === 'quote' && (
                  <div class="w-full h-full bg-slate-800 rounded flex items-center justify-center">
                    <svg
                      class="w-12 h-12 text-blue-400"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z" />
                    </svg>
                  </div>
                )}
                {item.data.type === 'audio' && (
                  <div class="w-full h-full bg-slate-800 rounded flex items-center justify-center">
                    <svg
                      class="w-12 h-12 text-orange-400"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5h4V7h2v5h4l-5 5z" />
                    </svg>
                  </div>
                )}
                {item.data.type === 'video' && (
                  <div class="w-full h-full bg-slate-800 rounded flex items-center justify-center">
                    <svg
                      class="w-12 h-12 text-violet-400"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                )}
                {item.data.type === 'photo' && item.data.image && (
                  <img
                    src={`/${item.data.image}`.replace(/^\/+/, '/')}
                    alt={item.data.title || 'Post image'}
                    class="w-full h-full object-cover rounded"
                  />
                )}
              </div>

              {/* Content */}
              <div class="flex-grow min-w-0">
                {item.data.title && (
                  <h3 class="font-semibold text-lg text-white mb-2 line-clamp-3">
                    {item.data.title}
                  </h3>
                )}
                <p class="text-gray-300 text-sm line-clamp-3 mb-3">
                  {(item.data.content || item.body).replace(/<[^>]*>/g, '').substring(0, 200)}...
                </p>
                <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400">
                  <span class="px-2 py-1 bg-slate-800 rounded">
                    {item.data.type}
                  </span>
                  <time>{new Date(item.data.publishedAt).toLocaleDateString()}</time>
                  {item.data.source && (
                    <span class="text-gray-500">via {item.data.source}</span>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {hasMore && (
        <button
          id="load-more-btn"
          class="w-full py-3 px-4 bg-slate-800 hover:bg-slate-700 text-white rounded-lg transition-colors"
        >
          Load More ({totalItems - 100} remaining)
        </button>
      )}
    </div>
  </div>
</PageLayout>

<script define:vars={{ allItems: JSON.stringify(allCommonplaceItems.slice(100)), postsPerLoad: 100 }}>
  let currentIndex = 0;
  const container = document.getElementById('posts-container');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const allItems = JSON.parse(allItems);

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      try {
        const nextBatch = allItems.slice(currentIndex, currentIndex + postsPerLoad);
        
        nextBatch.forEach(item => {
          const div = document.createElement('div');
          div.className = 'bg-slate-900 border border-slate-700 rounded-lg overflow-hidden hover:border-slate-600 transition-colors';
          div.innerHTML = `
            <div class="p-4 md:p-6 flex flex-col md:flex-row gap-4">
              <div class="flex-shrink-0 w-full md:w-32 h-32">
                ${item.data.type === 'quote' ? `
                  <div class="w-full h-full bg-slate-800 rounded flex items-center justify-center">
                    <svg class="w-12 h-12 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z" />
                    </svg>
                  </div>
                ` : ''}
                ${item.data.type === 'audio' ? `
                  <div class="w-full h-full bg-slate-800 rounded flex items-center justify-center">
                    <svg class="w-12 h-12 text-orange-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5h4V7h2v5h4l-5 5z" />
                    </svg>
                  </div>
                ` : ''}
                ${item.data.type === 'video' ? `
                  <div class="w-full h-full bg-slate-800 rounded flex items-center justify-center">
                    <svg class="w-12 h-12 text-violet-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                ` : ''}
                ${item.data.type === 'photo' && item.data.image ? `
                  <img src="${item.data.image}" alt="${item.data.title || 'Post'}" class="w-full h-full object-cover rounded" />
                ` : ''}
              </div>
              <div class="flex-grow min-w-0">
                ${item.data.title ? `<h3 class="font-semibold text-lg text-white mb-2 line-clamp-2">${item.data.title.substring(0, 100)}${item.data.title.length > 100 ? '...' : ''}</h3>` : ''}
                <p class="text-gray-300 text-sm line-clamp-3 mb-3">${item.data.content.replace(/<[^>]*>/g, '').substring(0, 200)}...</p>
                <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400">
                  <span class="px-2 py-1 bg-slate-800 rounded">${item.data.type}</span>
                  <time>${new Date(item.data.publishedAt).toLocaleDateString()}</time>
                  ${item.data.source ? `<span class="text-gray-500">via ${item.data.source}</span>` : ''}
                </div>
              </div>
            </div>
          `;
          container.appendChild(div);
        });

        currentIndex += postsPerLoad;
        const remaining = allItems.length - currentIndex;
        
        if (remaining > 0) {
          loadMoreBtn.textContent = `Load More (${remaining} remaining)`;
        } else {
          loadMoreBtn.style.display = 'none';
        }
      } catch (error) {
        console.error('Error loading more posts:', error);
        loadMoreBtn.textContent = 'Error loading posts';
        loadMoreBtn.disabled = true;
      }
    });
  }
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
