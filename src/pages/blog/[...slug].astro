---
import BlogLayout from '@/layouts/BlogLayout.astro';
import { render } from 'astro:content';
import { getBlogReadingTime, getMergedBlogEntries } from '@/lib/load-blog-content';
import PortableText from '@/components/sanity/PortableText.astro';

export async function getStaticPaths() {
  const posts = await getMergedBlogEntries();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const localContent = post.source === 'local' && post.localEntry
  ? await render(post.localEntry as Parameters<typeof render>[0])
  : null;
const Content = localContent?.Content;
---

<BlogLayout
  title={post.title}
  description={post.description}
  readingTime={getBlogReadingTime(post)}
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  author={post.author}
  image={post.image}
  imageAlt={post.imageAlt}
  svgSlug={post.svgSlug}
  tags={post.tags}
  slug={post.slug}
>
  {Content ? <Content /> : <PortableText value={Array.isArray(post.body) ? post.body : []} />}
</BlogLayout>
