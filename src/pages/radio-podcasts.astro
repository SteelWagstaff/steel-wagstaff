---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import DateMeta from '@/components/ui/data-display/DateMeta.astro';
import MediaCard from '@/components/radio/MediaCard.astro';
import { resolveMusicImage } from '@/lib/music-image-resolver';
import heroImage from '@/assets/blog/IMG_1842.jpg';

const music = await getCollection('music', ({ data }) => {
  return !data.draft;
});
const podcasts = await getCollection('podcasts', ({ data }) => {
  return !data.draft;
});

// Separate podcast series
const offTheChainAll = podcasts
  .filter(p => p.data.podcast === 'Off the Chain')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const themeSongsAll = podcasts
  .filter(p => p.data.podcast === 'Theme Songs')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Filter Steel's Magnolias shows from music collection
const steelsMagnoliasAll = music
  .filter(m => m.id.includes('show-'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Filter mixtapes (have 'mixtape' tag)
const mixtapesAll = music
  .filter(m => !m.id.includes('show-') && m.data.tags.includes('mixtape'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Filter playlists (exclude shows and mixtapes)
const playlistsAll = music
  .filter(m => !m.id.includes('show-') && !m.data.tags.includes('mixtape'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Limit to 6 items per section
const playlists = playlistsAll.slice(0, 6);
const mixtapes = mixtapesAll.slice(0, 6);
const steelsMagnolias = steelsMagnoliasAll.slice(0, 6);
const offTheChain = offTheChainAll.slice(0, 6);
const themeSongs = themeSongsAll.slice(0, 6);

// Helper to compute slug from id (removes 'en/' prefix)
const getSlug = (id: string) => id.replace('en/', '');
---

<PageLayout title="Radio + Podcasts" description="Spotify playlists, mixtapes, college radio shows, and episodes from two podcasts I made in grad school.">
  <div class="bg-gradient-to-b from-background to-background/50">
    <!-- Header -->
    <div class="mx-auto max-w-4xl px-6 py-8">
      <h1 class="text-4xl font-bold mb-4">Radio + Podcasts</h1>
      <p class="text-lg text-muted-foreground mb-8">
        I love independent and community-supported radio. I have very  happy memories of making a couple of amateur podcasts and hosting a student radio show in grad school.
      </p>
      
      <!-- Hero Image -->
      <div class="relative w-full h-64 md:h-80 lg:h-96 overflow-hidden rounded-lg mb-8">
        <Image 
          src={heroImage} 
          alt="Steel in WSUM studio"
          width={1200}
          height={400}
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Content Sections -->
    <div class="mx-auto max-w-4xl px-6 space-y-16 pb-16">
      
      <!-- Spotify Playlists -->
      <section>
        <h2 class="text-3xl font-bold mb-2"><a href="/radio-podcasts/topics/playlists" class="hover:text-primary transition-colors">What I've Been Listening To</a></h2>
        <p class="text-muted-foreground mb-6">Monthly curated playlists of favorite tracks</p>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {playlists.map((item) => {
            return (
              <MediaCard
                title={item.data.title}
                href={`/music/${getSlug(item.id)}`}
                publishedAt={item.data.publishedAt}
                description={item.data.description}
                image={item.data.image}
                imageAlt={item.data.imageAlt}
                tags={item.data.tags}
                groupLabel="Playlists"
                groupSlug="playlists"
              />
            );
          })}
        </div>
        {playlistsAll.length > 6 && (
          <div class="mt-6">
            <a 
              href="/music/playlists"
              class="inline-flex items-center justify-center px-6 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-background transition-colors font-medium"
            >
              See All Playlists
            </a>
          </div>
        )}
      </section>
      <section>
        <h2 class="text-3xl font-bold mb-2"><a href="/radio-podcasts/topics/mixtapes" class="hover:text-primary transition-colors">Mixtapes</a></h2>
        <p class="text-muted-foreground mb-6">An assortment of mixtapes I've made as gifts for family and friends over the years. A lost art.</p>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {mixtapes.map((item) => {
            return (
              <MediaCard
                title={item.data.title}
                href={`/music/${getSlug(item.id)}`}
                publishedAt={item.data.publishedAt}
                description={item.data.description}
                image={item.data.image}
                imageAlt={item.data.imageAlt}
                tags={item.data.tags}
                groupLabel="Mixtapes"
                groupSlug="mixtapes"
              />
            );
          })}
        </div>
        {mixtapesAll.length > 6 && (
          <div class="mt-6">
            <a 
              href="/music/mixtapes"
              class="inline-flex items-center justify-center px-6 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-background transition-colors font-medium"
            >
              See All Mixtapes
            </a>
          </div>
        )}
      </section>
<section>
        <h2 class="text-3xl font-bold mb-2"><a href="/radio-podcasts/topics/steels-magnolias" class="hover:text-primary transition-colors">Steel's Magnolias</a></h2>
        <p class="text-muted-foreground mb-6">For several months in 2012, I hosted Steel's Magnolias, a weekly music show on <a href="https://wsum.org/" class="text-brand-500 hover:underline">WSUM</a> (91.7FM in Madison), the University of Wisconsin-Madison's student radio station. On each episode I'd play an hour or two of music organized around a single shared theme. Sadly, I had to stop making the show when I started a full-time job at the university. You can listen to old episodes below:</p>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {steelsMagnolias.map((item) => {
            return (
              <MediaCard
                title={item.data.title}
                href={`/music/${getSlug(item.id)}`}
                publishedAt={item.data.publishedAt}
                description={item.data.description}
                image={item.data.image}
                imageAlt={item.data.imageAlt}
                tags={item.data.tags}
                groupLabel="Steel's Magnolias"
                groupSlug="steels-magnolias"
              />
            );
          })}
        </div>
        {steelsMagnoliasAll.length > 6 && (
          <div class="mt-6">
            <a 
              href="/steels-magnolias"
              class="inline-flex items-center justify-center px-6 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-background transition-colors font-medium"
            >
              See All Episodes
            </a>
          </div>
        )}
      </section>
      
      <!-- OTC with Dave & Steel -->
      <section>
        <h2 class="text-3xl font-bold mb-2"><a href="/radio-podcasts/topics/off-the-chain" class="hover:text-primary transition-colors">Off the Chain Podcast</a></h2>
        <p class="text-muted-foreground mb-6">In January 2015 I started making a Off the Chain with Dave & Steel, a DIY podcast with my old college roommate <a href="https://asknursedave.blogspot.com/" class="text-brand-500 hover:underline">Dave Jenson</a>. We ran it as a ramshackle variety show, with regular segments dedicated to things Dave loves (action movies, incredible feats of human endurance, children’s books), things I love (terrible haircuts, unusual names, documentary films) and things we both love (sports, music, & literature).</p>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {offTheChain.map((item) => {
            const resolvedImage = resolveMusicImage(item.data.image);
            return (
            <a
              href={`/podcasts/${getSlug(item.id)}`}
              class="group block rounded-lg border border-border hover:border-primary hover:shadow-lg transition-all overflow-hidden"
            >
              {resolvedImage && (
                <div class="aspect-[3/2] bg-muted overflow-hidden">
                  {typeof resolvedImage === 'string' ? (
                    <img 
                      src={resolvedImage}
                      alt={item.data.imageAlt || item.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                      loading="lazy"
                    />
                  ) : (
                    <Image 
                      src={resolvedImage}
                      alt={item.data.imageAlt || item.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    />
                  )}
                </div>
              )}
              <div class="p-4">
                <h3 class="font-semibold group-hover:text-primary transition-colors line-clamp-2">
                  {item.data.title}
                </h3>
                {item.data.description && (
                  <p class="text-sm text-muted-foreground mt-1 line-clamp-2">
                    {item.data.description}
                  </p>
                )}
                <div class="mt-2 flex items-center gap-1 text-sm text-muted-foreground">
                  Episode {item.data.episode} •
                  <DateMeta date={item.data.publishedAt} />
                </div>
              </div>
            </a>
            );
          })}
        </div>
        {offTheChainAll.length > 6 && (
          <div class="mt-6">
            <a 
              href="/off-the-chain"
              class="inline-flex items-center justify-center px-6 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-background transition-colors font-medium"
            >
              See All Episodes
            </a>
          </div>
        )}
      </section>

      <!-- Theme Songs Podcast -->
      {themeSongs.length > 0 && (
        <section>
          <h2 class="text-3xl font-bold mb-2"><a href="/radio-podcasts/topics/theme-songs" class="hover:text-primary transition-colors">Theme Songs Podcast</a></h2>
          <p class="text-muted-foreground mb-6">After 70+ episodes of Off the Chain, we retired the show and started making a new music-themed podcast called Theme Songs, which ran from August 2017-March 2018. We typically invited old friends on the show as guests, giving us an excuse to catch up with them as much as anything else.</p>
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {themeSongs.map((item) => {
              const resolvedImage = resolveMusicImage(item.data.image);
              return (
              <a
                href={`/podcasts/${getSlug(item.id)}`}
                class="group block rounded-lg border border-border hover:border-primary hover:shadow-lg transition-all overflow-hidden"
              >
                {resolvedImage && (
                  <div class="aspect-[3/2] bg-muted overflow-hidden">
                    {typeof resolvedImage === 'string' ? (
                      <img 
                        src={resolvedImage}
                        alt={item.data.imageAlt || item.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                        loading="lazy"
                      />
                    ) : (
                      <Image 
                        src={resolvedImage}
                        alt={item.data.imageAlt || item.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                      />
                    )}
                  </div>
                )}
                <div class="p-4">
                  <h3 class="font-semibold group-hover:text-primary transition-colors line-clamp-2">
                    {item.data.title}
                  </h3>
                  {item.data.description && (
                    <p class="text-sm text-muted-foreground mt-1 line-clamp-2">
                      {item.data.description}
                    </p>
                  )}
                  <div class="mt-2 flex items-center gap-1 text-sm text-muted-foreground">
                    {item.data.episode && `Episode ${item.data.episode} • `}
                    <DateMeta date={item.data.publishedAt} />
                  </div>
                </div>
              </a>
              );
            })}
          </div>
          {themeSongsAll.length > 6 && (
            <div class="mt-6">
              <a 
                href="/theme-songs"
                class="inline-flex items-center justify-center px-6 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-background transition-colors font-medium"
              >
                See All Episodes
              </a>
            </div>
          )}
        </section>
      )}

    </div>
  </div>
</PageLayout>
