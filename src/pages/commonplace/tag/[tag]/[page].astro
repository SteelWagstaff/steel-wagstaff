---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import CommonplaceArchive from '@/components/commonplace/CommonplaceArchive.astro';
import {
  filterCommonplaceEntriesByTag,
  getCommonplaceCounts,
  getCommonplacePageCount,
  getCommonplacePageEntries,
  getCommonplaceSharedTags,
  getCommonplaceTagLabels,
  sortCommonplaceEntries,
} from '@/lib/commonplace';

export async function getStaticPaths() {
  const allItems = sortCommonplaceEntries(await getCollection('commonplace', ({ data }) => {
    return !data.draft && data.locale === 'en';
  }));
  const counts = getCommonplaceCounts(allItems);
  // Only tags with two or more posts get a page, so every link in the archive resolves.
  const sharedTags = getCommonplaceSharedTags(allItems);
  const labels = getCommonplaceTagLabels(allItems);
  const paths = [];

  for (const tag of sharedTags) {
    const taggedItems = filterCommonplaceEntriesByTag(allItems, tag);
    const totalPages = getCommonplacePageCount(taggedItems.length);

    for (let page = 1; page <= totalPages; page += 1) {
      paths.push({
        params: { tag, page: String(page) },
        props: {
          items: getCommonplacePageEntries(taggedItems, page),
          totalItems: taggedItems.length,
          currentPage: page,
          totalPages,
          counts,
          sharedTags,
          tagFilter: tag,
          tagLabel: labels.get(tag) ?? tag,
        },
      });
    }
  }

  return paths;
}

const { items, totalItems, currentPage, totalPages, counts, sharedTags, tagFilter, tagLabel } = Astro.props;
---

<PageLayout
  title={`The Commonplace: #${tagLabel}`}
  description={`Commonplace entries tagged ${tagLabel}.`}
>
  <CommonplaceArchive
    items={items}
    totalItems={totalItems}
    currentPage={currentPage}
    totalPages={totalPages}
    counts={counts}
    sharedTags={sharedTags}
    tagFilter={tagFilter}
    tagLabel={tagLabel}
  />
</PageLayout>
